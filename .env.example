# Variables de entorno para Restaurant OS
# Copia este archivo a .env.local y configura tus valores

# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# ELEVENLABS / LEVEL LABS - VOZ
# ============================================

# URL del servidor WebSocket de ElevenLabs
# Desarrollo local: ws://localhost:8080
# Producción: wss://api.tuservidor.com/voice
NEXT_PUBLIC_LEVELLABS_WS_URL=ws://localhost:8080

# API Key para autenticación con ElevenLabs (opcional si tu servidor lo requiere)
NEXT_PUBLIC_LEVELLABS_API_KEY=your_elevenlabs_api_key_here

# ID de tu restaurante (para contexto en el servidor)
NEXT_PUBLIC_RESTAURANT_ID=nou-espantall-cambrils

# Habilitar logs de debugging (true/false)
NEXT_PUBLIC_VOICE_DEBUG=true

# ============================================
# MODO SIMULACIÓN
# ============================================

# Habilitar modo mock (sin conexión real a servicios externos)
# Valores: 'true' | 'false'
NEXT_PUBLIC_MOCK_MODE=false

# Tipo de cliente de voz a usar
# Valores: 'mock' | 'levellabs'
NEXT_PUBLIC_VOICE_CLIENT=levellabs
